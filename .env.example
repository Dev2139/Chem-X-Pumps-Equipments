# MongoDB connection string (local instance or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/chemx

# API server port
PORT=5000

# Admin panel password (used at /admin login)
ADMIN_PASSWORD=your-admin-password

# Secret used to sign admin session tokens
JWT_SECRET=your-jwt-secret

# Nodemailer SMTP Configuration for Email Submissions
# (If omitted, a temporary Ethereal test email account will be used in dev mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_RECEIVER_EMAIL=chemxpumps@gmail.com
